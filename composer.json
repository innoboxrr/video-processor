{
    "name": "innoboxrr/video-processor",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\VideoProcessor\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require-dev": {
        "innoboxrr/larapack-generator": "^9.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "require": {
        "pbmedia/laravel-ffmpeg": "^8.3",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\VideoProcessor\\Providers\\AppServiceProvider",
                "Innoboxrr\\VideoProcessor\\Providers\\AuthServiceProvider",
                "Innoboxrr\\VideoProcessor\\Providers\\EventServiceProvider",
                "Innoboxrr\\VideoProcessor\\Providers\\RouteServiceProvider"
            ]
        }
